# =============================================================================
# TermRelay production environment
# Copy to .env and replace every CHANGE_ME value before starting.
# =============================================================================

# Image published by .github/workflows/build-termrelay-image.yml
TERMRELAY_IMAGE=ghcr.io/yuchenm1303-png/termrelay:custom-ui

# Use a domain for automatic HTTPS, for example: relay.example.com
# For temporary IP-only testing use: http://203.0.113.10
TERMRELAY_DOMAIN=relay.example.com

# First-stage private deployment. Change to standard when enabling public users,
# balances, subscriptions and other SaaS-oriented features.
RUN_MODE=simple
TZ=Asia/Shanghai
OPS_ENABLED=false

# PostgreSQL
POSTGRES_USER=termrelay
POSTGRES_DB=termrelay
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME_MINUTES=30
DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5

# Redis
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0
REDIS_POOL_SIZE=256
REDIS_MIN_IDLE_CONNS=10

# Initial administrator. AUTO_SETUP creates this account on the first start.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Keep these values fixed after the first deployment. Replacing them later will
# invalidate sessions and can make existing TOTP data unreadable.
JWT_SECRET=CHANGE_ME_64_HEX_CHAR_JWT_SECRET
JWT_EXPIRE_HOUR=24
TOTP_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHAR_TOTP_KEY

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Production network policy. The first release only needs HTTPS upstreams.
SECURITY_URL_ALLOWLIST_ENABLED=false

# OpenAI / Codex transport defaults
GATEWAY_OPENAI_RESPONSE_HEADER_TIMEOUT=0
