{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && corepack enable && corepack prepare pnpm@9.15.9 --activate && pnpm install --no-frozen-lockfile",
  "buildCommand": "cd frontend && pnpm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.smirel.com/api/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "https://api.smirel.com/v1/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
